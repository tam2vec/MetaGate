{
  "manifest_version": 3,
  "name": "MetaGate for DataHub",
  "version": "0.1.0",
  "description": "Automatically shows MetaGate allow/block decisions on local DataHub asset pages.",
  "permissions": ["storage"],
  "options_page": "options.html",
  "action": {
    "default_title": "MetaGate settings"
  },
  "host_permissions": [
    "http://localhost:9002/*",
    "http://127.0.0.1:9002/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:9002/*",
        "http://127.0.0.1:9002/*"
      ],
      "js": ["metagate-datahub-panel.js"],
      "run_at": "document_start"
    }
  ]
}
