{
  "name": "metagate-datahub-extension",
  "version": "0.1.0",
  "description": "Prototype DataHub asset-page panel for MetaGate AI action checks.",
  "mount": {
    "surface": "dataset.summary.sidebar",
    "selector_hint": "[data-testid='entity-profile-sidebar']",
    "fallback": "append to asset summary side panel"
  },
  "api": {
    "runs": "/api/runs",
    "evaluate": "/api/evaluate?urn={urn}&capability={capability}"
  },
  "permissions": [
    "datahub.entity.read",
    "metagate.evaluate"
  ],
  "write_permissions_optional": [
    "datahub.assertions.write",
    "datahub.tasks.write"
  ],
  "safe_defaults": {
    "read_only": true,
    "writeback_requires_explicit_mutation_configuration": true
  },
  "assets": [
    "metagate-panel.js",
    "panel-contract.json"
  ]
}
